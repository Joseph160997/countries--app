# REST Countries v5 — free key at https://api.restcountries.com
# Copy this file to .env and fill in your real key. NEVER commit .env
VITE_COUNTRIES_API_KEY=your_api_key_here

# Optional local Chrome override for Playwright.
# Leave unset in CI/GitHub Actions so Playwright uses its managed Chromium.
CHROMIUM_PATH=C:/Users/USER/Desktop/chrome-win64/chrome.exe
